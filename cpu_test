name: Compiler les tests Vita

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    container: vitasdk/vitasdk:latest
    steps:
      - uses: actions/checkout@v4
      - name: Compiler le test de dessin
        run: |
          mkdir build
          cd build
          cmake ..
          make
      - name: Compiler le test CPU
        run: |
          mkdir build_cpu
          cd build_cpu
          cmake ../cpu_test
          make
      - name: Garder les .vpk
        uses: actions/upload-artifact@v4
        with:
          name: tests-vita
          path: |
            build/heist_perf_test.vpk
            build_cpu/heist_cpu_test.vpk
